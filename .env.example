# Copy to .env and fill in. Never commit .env.

# Cloudflare Workers AI (free tier): dashboard → Account ID, and an API token
# with the "Workers AI" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: only for the OpenAI tier.
OPENAI_API_KEY=

# SEC EDGAR requires a User-Agent that identifies you, e.g. "Your Name you@example.com".
SEC_USER_AGENT=
